# MySQL server-side only. Never prefix these variables with NEXT_PUBLIC_.
DB_HOST=your-mysql-host
DB_PORT=3306
DB_USER=your-mysql-user
DB_PASSWORD=your-mysql-password
DB_NAME=your-database-name
DB_SSL=true

# Generate a random value with at least 32 characters. Keep it private.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Tripay
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_MERCHANT_CODE=
TRIPAY_CALLBACK_URL=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# APP_URL wajib berupa HTTPS origin publik pada production.
# Development mengikuti host yang sedang dipakai, misalnya http://localhost:3000.
APP_URL=http://localhost:3000
TRIPAY_MODE=sandbox
TRIPAY_PAYMENT_METHOD=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
# Daftarkan callback development dan production yang tepat di Google OAuth Console.
# Production callback: https://your-store-domain.example/api/auth/google/callback
# https://your-store-domain.example/api/payments/tripay/callback
# Download the database CA from the database provider and set DB_SSL_CA to its file path.

# Jubelio Shipment: local reference mock by default; replace with sandbox URL and real credentials later.
JUBELIO_BASE_URL=http://localhost:4010
JUBELIO_CLIENT_ID=mock-client
JUBELIO_CLIENT_SECRET=mock-secret
JUBELIO_AUTH_SCHEME=bearer
JUBELIO_WEBHOOK_SECRET=mock-webhook-secret
JUBELIO_TIMEOUT_MS=15000
JUBELIO_REF_NO_MODE=auto

# Sender warehouse. Replace with the Jubelio Location Management values.
WAREHOUSE_NAME=Toko Comotrade
WAREHOUSE_PHONE=
WAREHOUSE_EMAIL=
WAREHOUSE_ADDRESS=
WAREHOUSE_AREA_ID=
WAREHOUSE_ZIPCODE=
WAREHOUSE_COORDINATE=

# Local estimation/subsidy settings, all money in Rupiah; package dimensions cm, weight gram.
VOLUMETRIC_DIVISOR=6000
FREE_SHIPPING_MIN_SUBTOTAL=200000
FREE_SHIPPING_MAX_SUBSIDY=20000
RECONCILE_STALE_AFTER_MINUTES=60